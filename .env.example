# Copia este archivo como .env y cambia los valores.

# Puerto local de la app
PORT=3200

# Clave para entrar a la agenda
ADMIN_PASSWORD=cambia-esta-clave

# Cadena larga y aleatoria para firmar la sesión (no la compartas)
SESSION_SECRET=cambia-esto-por-una-cadena-larga-y-aleatoria

# Pon true cuando la app esté publicada con HTTPS
COOKIE_SECURE=false

# Archivo de la base de datos (por defecto: data/taller.db)
# DB_PATH=/ruta/al/disco/taller.db
